# Copy to .env.local (git-ignored) and fill in. Secrets only: URLs, models and ports live in src/config/services.ts.
# One KEY=value per line; put comments on their own line.

# https://www.themoviedb.org/settings/api  (the "API Read Access Token")
TMDB_TOKEN=

# https://console.groq.com/keys
GROQ_API_KEY=

# Azure Speech key (browser only; Vite exposes VITE_* variables to the page)
VITE_AZURE_KEY=
